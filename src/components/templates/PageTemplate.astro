---
import Footer from "@organisms/Footer.astro";

interface Props {
  hasFooter?: boolean;
}

const { hasFooter = true } = Astro.props;
---

<div class="w-full" data-page-template>
  <slot />
  {hasFooter && <Footer />}
</div>

<script>
  function resetScroll() {
    // Respeta la navegación por ancla; si no la hay, arranca arriba.
    if (window.location.hash) return;
    window.scrollTo(0, 0);
  }

  resetScroll();
  document.addEventListener("astro:after-swap", resetScroll);
</script>
