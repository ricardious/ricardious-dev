---
/**
 * ImageSlider: auto-cycling image slider.
 * Transition is a colorless clip-path wipe between two stacked layers,
 * so the incoming image reveals over the current one with no color / flash.
 */
import projects from "@lib/constants/projects";

const images = projects.map((p) => p.coverImgSmall);
---

<div class="img-slider relative w-full aspect-3/2 overflow-hidden cursor-pointer">
  <img
    class="slider-base absolute inset-0 h-full w-full object-cover"
    src={images[0]}
    alt="Project preview"
    loading="eager"
  />
  <img
    class="slider-top absolute inset-0 h-full w-full object-cover"
    src={images[0]}
    alt=""
    aria-hidden="true"
    style="clip-path: inset(0 100% 0 0);"
  />
</div>

<script define:vars={{ images }}>
  function initSlider() {
    const container = document.querySelector(".img-slider");
    if (!container || images.length < 2) return;

    const base = container.querySelector(".slider-base");
    const top = container.querySelector(".slider-top");
    if (!base || !top) return;

    if (container.__sliderTimer) clearInterval(container.__sliderTimer);

    let index = 0;
    const WIPE = 700;

    container.__sliderTimer = setInterval(() => {
      const next = (index + 1) % images.length;

      // Prepare the incoming image, hidden on the left.
      top.src = images[next];
      top.style.transition = "none";
      top.style.clipPath = "inset(0 100% 0 0)";
      void top.offsetWidth; // force reflow so the reset applies

      // Wipe it in (left -> right).
      top.style.transition = `clip-path ${WIPE}ms cubic-bezier(0.77, 0, 0.175, 1)`;
      top.style.clipPath = "inset(0 0 0 0)";

      // Commit to the base layer and reset the top for the next cycle.
      setTimeout(() => {
        base.src = images[next];
        top.style.transition = "none";
        top.style.clipPath = "inset(0 100% 0 0)";
        index = next;
      }, WIPE);
    }, 4000);
  }

  initSlider();
  document.addEventListener("astro:after-swap", initSlider);
</script>
