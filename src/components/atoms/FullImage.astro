---
/**
 * FullImage: full-width, full-bleed image section with a pure-CSS parallax.
 * The background image is fixed to the viewport (slow layer) while the optional
 * brand overlay scrolls with the section (fast layer) for a layered parallax.
 * No JS, no smooth-scroll dependency.
 */
import LogoMark from "@atoms/LogoMark.astro";

interface Props {
  src: string;
  alt?: string;
  brand?: boolean;
}

const { src, alt = "", brand = false } = Astro.props;
---

<div
  class="full-image relative isolate w-screen overflow-hidden h-screen max-md:h-[60vh] max-md:mb-[10vh]"
>
  <div class="parallax-inner absolute inset-0">
    <img
      src={src}
      alt={alt}
      class="w-full h-[120%] object-cover object-top"
      loading="lazy"
    />
  </div>

  {
    brand && (
      <div class="brand-layer pointer-events-none absolute inset-0 z-10 flex flex-col items-center justify-center gap-6 text-white max-md:gap-4">
        <LogoMark class="size-20 drop-shadow-[0_4px_30px_rgba(0,0,0,0.55)] max-md:size-14" />
        <span class="font-heading text-[clamp(2.5rem,7vw,5.5rem)] uppercase leading-none tracking-[0.06em] drop-shadow-[0_4px_36px_rgba(0,0,0,0.6)]">
          Ricardious
        </span>
      </div>
    )
  }
</div>

<style>
  .full-image {
    clip-path: inset(0);
  }

  .parallax-inner {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
  }

  @media (max-width: 765px) {
    .parallax-inner {
      height: 60vh;
      position: absolute;
    }
  }
</style>
