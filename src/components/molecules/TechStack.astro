---
/**
 * TechStack: grouped list of technologies with their monochrome logos.
 * Data in src/lib/constants/stack.ts, logos in src/assets/tech/<slug>.svg.
 */
import Headline from "@atoms/Headline.astro";
import stack from "@lib/constants/stack";

const icons = import.meta.glob<string>("/src/assets/tech/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const iconFor = (slug: string) => icons[`/src/assets/tech/${slug}.svg`];
---

<section class="tech-stack margin-page flex w-screen flex-col items-center">
  <Headline name="Stack tecnológico" />

  <div class="grid w-full gap-x-10 gap-y-14 py-4 md:grid-cols-3">
    {
      stack.map((group) => (
        <div>
          <h3 class="text-text mb-7 text-[12px] uppercase tracking-[0.14em]">
            {group.label}
          </h3>
          <ul class="flex flex-col gap-5">
            {group.items.map((item) => (
              <li class="flex items-center gap-4">
                <span
                  class="tech-icon text-text-standard block size-5 shrink-0"
                  set:html={iconFor(item.slug)}
                />
                <span class="text-text-standard text-[clamp(1rem,1.6vw,1.15rem)] font-medium leading-none">
                  {item.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .tech-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
</style>
