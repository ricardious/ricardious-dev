---
/**
 * ProjectsPreview: Lists the first 4 projects with hover image effect.
 * Astro component with vanilla JS for mouse-following hover images.
 */
import projects from "@lib/constants/projects";

const previewProjects = projects.slice(0, 4);
const hasMoreProjects = projects.length > previewProjects.length;
---

<div class="projects-preview w-full">
  {
    previewProjects.map((project, index) => (
      <div class="project-item group w-full" data-cover={project.coverImg}>
        <a
          href={`/works/${project.path}`}
          class="project-link flex items-start transition-transform duration-300 ease-out hover:translate-x-4"
        >
          <span class="text-[12px] text-text mt-1.5 max-md:mt-1">
            ({index + 1 < 10 ? `0${index + 1}` : index + 1})
          </span>
          <span class="ml-7 font-heading uppercase text-h1 max-md:ml-6.5 max-sm:ml-4.5">
            {project.name}
          </span>
        </a>
        <div class="separator" />
      </div>
    ))
  }

  {
    hasMoreProjects && (
      <div class="project-item w-full">
        <a
          href="/works"
          class="flex items-start transition-transform duration-300 ease-out hover:translate-x-4"
        >
          <span class="text-[12px] text-text mt-1.5 max-md:mt-1">(XX)</span>
          <span
            class="ml-7 font-heading uppercase text-h1 max-md:ml-6.5 max-sm:ml-4.5"
          >
            more projects
          </span>
        </a>
        <div class="separator"></div>
      </div>
    )
  }

  <!-- Hover image follower (desktop only) -->
  <div
    class="hover-image-wrapper fixed top-0 left-0 z-10 pointer-events-none max-md:hidden"
  >
    <div class="hover-image opacity-0 transition-opacity duration-400 ease-out">
      <img class="w-[30vw] h-auto object-cover" src="" alt="" />
    </div>
  </div>
</div>

<script>
  function initProjectsPreview() {
    const previewRoot = document.querySelector(
      ".projects-preview",
    ) as HTMLElement | null;
    const hoverWrapper = previewRoot?.querySelector(
      ".hover-image-wrapper",
    ) as HTMLElement | null;
    const hoverContainer = previewRoot?.querySelector(
      ".hover-image",
    ) as HTMLElement | null;
    const hoverImg = hoverContainer?.querySelector(
      "img",
    ) as HTMLImageElement | null;

    if (!previewRoot || !hoverWrapper || !hoverContainer || !hoverImg) return;

    const previousCleanup = (
      previewRoot as HTMLElement & {
        __projectsPreviewCleanup?: () => void;
      }
    ).__projectsPreviewCleanup;
    previousCleanup?.();

    const items = previewRoot.querySelectorAll<HTMLElement>(".project-item[data-cover]");
    const cleanups: Array<() => void> = [];

    const updatePosition = (event: MouseEvent) => {
      hoverContainer.style.transform = `translate3d(${event.clientX}px, ${event.clientY}px, 0)`;
    };

    const hidePreview = () => {
      hoverContainer.style.opacity = "0";
    };

    const onWindowLeave = () => {
      hidePreview();
    };

    window.addEventListener("mousemove", updatePosition);
    window.addEventListener("mouseleave", onWindowLeave);

    cleanups.push(() => window.removeEventListener("mousemove", updatePosition));
    cleanups.push(() => window.removeEventListener("mouseleave", onWindowLeave));

    items.forEach((item) => {
      const onEnter = () => {
        const cover = item.dataset.cover;
        if (!cover) return;

        hoverImg.src = cover;
        hoverContainer.style.opacity = "1";
      };

      const onLeave = () => {
        hidePreview();
      };

      item.addEventListener("mouseenter", onEnter);
      item.addEventListener("mouseleave", onLeave);

      cleanups.push(() => item.removeEventListener("mouseenter", onEnter));
      cleanups.push(() => item.removeEventListener("mouseleave", onLeave));
    });

    (
      previewRoot as HTMLElement & {
        __projectsPreviewCleanup?: () => void;
      }
    ).__projectsPreviewCleanup = () => {
      hidePreview();
      cleanups.forEach((cleanup) => cleanup());
    };
  }

  initProjectsPreview();
  document.addEventListener("astro:after-swap", initProjectsPreview);
</script>
