---
import LoaderContent from "@molecules/LoaderContent.astro";

interface Props {
  title?: string;
  id?: string;
  /** ms que se sostiene el 100% antes de retirarse */
  holdAfterComplete?: number;
  /** red de seguridad por si `load` nunca llega */
  fallbackTimeout?: number;
}

const {
  title = "ricardious",
  id = "loader",
  holdAfterComplete = 420,
  fallbackTimeout = 6000,
} = Astro.props;
---

<div
  id={id}
  class="loader bg-background fixed inset-0 z-10000 flex items-end"
  role="progressbar"
  aria-label="Cargando"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  transition:persist="loader"
  data-hold={holdAfterComplete}
  data-fallback={fallbackTimeout}
>
  <LoaderContent title={title} />
</div>

<style>
  /* Registrar la propiedad la vuelve interpolable: la barra y el contador
     se animan solos al cambiar el valor, sin bucle de requestAnimationFrame. */
  @property --loader-progress {
    syntax: "<integer>";
    inherits: true;
    initial-value: 0;
  }

  .loader {
    --loader-progress: 0;
    transition:
      --loader-progress 700ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 900ms cubic-bezier(0.77, 0, 0.175, 1);
    will-change: transform;
  }

  /* Se retira hacia arriba, igual que el panelWipe de las view transitions. */
  .loader[data-state="done"] {
    transform: translateY(-100%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .loader {
      transition:
        --loader-progress 1ms linear,
        opacity 200ms linear;
    }

    .loader[data-state="done"] {
      transform: none;
      opacity: 0;
    }
  }
</style>

<script>
  function initLoader() {
    const loader = document.getElementById("loader");
    if (!loader || loader.dataset.state === "done") return;

    const hold = Number(loader.dataset.hold) || 420;
    const fallback = Number(loader.dataset.fallback) || 6000;
    let settled = false;

    const set = (value: number) => {
      loader.style.setProperty("--loader-progress", String(value));
      loader.setAttribute("aria-valuenow", String(value));
    };

    const finish = () => {
      if (settled) return;
      settled = true;
      set(100);

      // El retiro va por temporizador y nunca atado a que la animación llegue
      // al final: si el compositor se congela, la página aparece igualmente.
      window.setTimeout(() => {
        loader.dataset.state = "done";
        loader.setAttribute("aria-hidden", "true");
      }, hold);
    };

    set(8);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => set(62), {
        once: true,
      });
    } else {
      set(62);
    }

    if (document.readyState === "complete") finish();
    else window.addEventListener("load", finish, { once: true });

    window.setTimeout(finish, fallback);
  }

  initLoader();
</script>
