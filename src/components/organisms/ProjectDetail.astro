---
import PageTemplate from "@templates/PageTemplate.astro";
import projects, { type Project } from "@/lib/constants/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const nextProject = projects[project.index + 1] ?? null;
---

<PageTemplate hasFooter={false} hasTransitionPanel={true}>
  <article class="bg-background text-text transition-colors duration-500">
    <section
      class="relative min-h-screen overflow-hidden"
      style={`background-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.55)), url(${project.visual1}); background-size: cover; background-position: center;`}
    >
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="relative z-10 mx-auto flex min-h-screen w-full max-w-7xl items-end px-6 pb-20 pt-32 md:px-10 lg:px-16 lg:pb-24">
        <div class="grid w-full gap-10 text-white lg:grid-cols-[minmax(0,1.5fr)_minmax(18rem,24rem)] lg:items-end">
          <div class="max-w-3xl">
            <p class="mb-4 text-xs uppercase tracking-[0.35em] text-white/70">Proyecto Seleccionado</p>
            <h1 class="text-h1 serif uppercase">{project.title}</h1>
            <p class="mt-6 max-w-2xl text-base leading-relaxed text-white/85 md:text-lg">
              {project.description}
            </p>
            {project.websiteLink && (
              <a
                class="mt-8 inline-flex items-center gap-3 border border-white/30 px-5 py-3 text-xs uppercase tracking-[0.28em] text-white transition hover:border-white hover:bg-white hover:text-black"
                href={project.websiteLink}
                target="_blank"
                rel="noreferrer"
              >
                Visitar sitio
              </a>
            )}
          </div>

          <div class="grid gap-6 border border-white/15 bg-black/15 p-6 backdrop-blur-sm md:grid-cols-3 lg:grid-cols-1 lg:gap-8 lg:p-8">
            <div>
              <h2 class="text-xs uppercase tracking-[0.28em] text-white/60">Fecha</h2>
              <p class="mt-3 text-sm uppercase tracking-[0.12em] text-white">{project.date}</p>
            </div>
            <div>
              <h2 class="text-xs uppercase tracking-[0.28em] text-white/60">Rol</h2>
              <p class="mt-3 text-sm uppercase tracking-[0.12em] text-white">{project.role}</p>
            </div>
            <div>
              <h2 class="text-xs uppercase tracking-[0.28em] text-white/60">Stack</h2>
              <p class="mt-3 text-sm uppercase tracking-[0.12em] text-white">{project.techs.join(", ")}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto w-full max-w-7xl px-6 py-20 md:px-10 lg:px-16 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:items-start">
        <div>
          <p class="text-xs uppercase tracking-[0.32em] text-text/60">Resumen</p>
          <h2 class="serif mt-4 text-4xl uppercase md:text-6xl">{project.title}</h2>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-text/80 md:text-lg">
            {project.overview ?? project.description}
          </p>
        </div>
        {project.highlights && project.highlights.length > 0 && (
          <div class="grid gap-4 border-t border-text/10 pt-6 text-sm leading-relaxed text-text/70 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0">
            {project.highlights.map((highlight) => <p>{highlight}</p>)}
          </div>
        )}
      </div>

      <div class="mt-16 overflow-hidden border border-text/10 bg-surface/30">
        <img
          class="h-auto w-full object-cover"
          src={project.coverImg}
          alt={`Preview for ${project.title}`}
          loading="eager"
        />
      </div>

      {project.sections && project.sections.length > 0 && (
        <div class="mt-16 grid gap-6 lg:grid-cols-3">
          {project.sections.map((section) => (
            <article class="border border-text/10 bg-surface/20 p-6 md:p-8">
              <p class="text-xs uppercase tracking-[0.32em] text-text/60">{section.eyebrow}</p>
              <h3 class="serif mt-4 text-3xl uppercase leading-tight md:text-4xl">
                {section.title}
              </h3>
              <div class="mt-6 grid gap-4 text-sm leading-relaxed text-text/75 md:text-base">
                {section.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </article>
          ))}
        </div>
      )}

      {project.toolGroups && project.toolGroups.length > 0 && (
        <div class="mt-16">
          <div class="mb-8">
            <p class="text-xs uppercase tracking-[0.32em] text-text/60">Stack</p>
            <h2 class="serif mt-4 text-4xl uppercase md:text-6xl">Herramientas</h2>
          </div>

          <div class="grid gap-6 lg:grid-cols-3">
            {project.toolGroups.map((group) => (
              <section class="border border-text/10 bg-surface/20 p-6 md:p-8">
                <h3 class="text-xs uppercase tracking-[0.32em] text-text/60">{group.label}</h3>
                <ul class="mt-6 grid gap-3 text-sm uppercase tracking-[0.08em] text-text/80">
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </section>
            ))}
          </div>
        </div>
      )}

      {project.gallery && project.gallery.length > 0 && (
        <div class="mt-16">
          <div class="mb-8 flex items-end justify-between gap-4">
            <div>
              <p class="text-xs uppercase tracking-[0.32em] text-text/60">Galería</p>
              <h2 class="serif mt-4 text-4xl uppercase md:text-6xl">Vistas del Proyecto</h2>
            </div>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            {project.gallery.map((image, imageIndex) => (
              <figure
                class:list={[
                  "overflow-hidden border border-text/10 bg-surface/30",
                  image.wide && "md:col-span-2",
                  !image.wide &&
                    project.gallery &&
                    project.gallery.length % 2 !== 0 &&
                    imageIndex === project.gallery.length - 1 &&
                    "md:col-span-2 md:mx-auto md:w-[min(100%,48rem)]",
                ]}
              >
                <img
                  class="h-auto w-full object-cover"
                  src={image.src}
                  alt={image.alt}
                  loading={imageIndex < 2 ? "eager" : "lazy"}
                />
              </figure>
            ))}
          </div>
        </div>
      )}
    </section>

    {nextProject && (
      <a
        href={`/works/${nextProject.path}`}
        class="group relative block min-h-[65vh] overflow-hidden"
      >
        <img
          class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
          src={nextProject.coverImg}
          alt={`Next project: ${nextProject.name}`}
        />
        <div class="absolute inset-0 bg-black/45 transition duration-500 group-hover:bg-black/35"></div>
        <div class="relative z-10 mx-auto flex min-h-[65vh] w-full max-w-7xl flex-col justify-end px-6 py-16 text-white md:px-10 lg:px-16">
          <p class="text-xs uppercase tracking-[0.35em] text-white/65">Siguiente Proyecto</p>
          <h2 class="serif mt-4 text-5xl uppercase md:text-7xl">{nextProject.name}</h2>
        </div>
      </a>
    )}
  </article>
</PageTemplate>
